{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "viziguide-app": {
      "root": "viziguide-app/frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "viziguide-app/backend",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "viziguide-app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "viziguide-app"
      }
    }
  ]
}
